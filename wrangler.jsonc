{
  "name": "faculty-senate-assistant-api",
  "main": "backend/worker.js",
  "compatibility_date": "2026-10-06",
  "workers_dev": true,
  "vars": {
    "AI_MODEL": "its_direct/pt2-claude-haiku-4.5-us",
    "ALLOWED_ORIGINS": "https://csckhanna.github.io",
    "DAILY_REQUEST_LIMIT": "100"
  },
  "durable_objects": {"bindings": [{"name": "PILOT_BUDGET", "class_name": "PilotBudget"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["PilotBudget"]}],
  "observability": {"enabled": false}
}
